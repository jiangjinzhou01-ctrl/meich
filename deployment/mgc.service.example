[Unit]
Description=MGC Digital Website
After=network.target

[Service]
Type=simple
User=mgc
Group=mgc
WorkingDirectory=/opt/mgc
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node /opt/mgc/app/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
